# ローカル実行（npm run dev）用の環境変数の雛形。
# リポジトリ直下に .env としてコピーして使う（.env は .gitignore 対象）。
#   cp .env.template .env
# Astro（import.meta.env / astro.config.mjs の loadEnv）が読む。シェルの環境変数が優先される。
# 未設定の運営者情報はダミー値で補われるため、すべて任意。

# アプリの接続先
PUBLIC_DEFAULT_ATP_SERVICE=https://api.bsky.app
PUBLIC_PLC_DIRECTORY_BASE_URL=https://plc.directory
PUBLIC_OGP_EXTRACTOR_API=https://ogpextractor.example.com
# 旧 UI のバックエンド（旧 UI を使わないならダミーの URL でよい）
PUBLIC_LEGACY_BACKEND_ENDPOINT=https://backend.example.com/api/v1

# 運営者情報（プライバシーポリシーに載る。未設定ならダミー値）
PUBLIC_OPERATOR_NAME=example-operator
PUBLIC_OPERATOR_EMAIL=operator@example.com
# 窓口の Bluesky ハンドル（@ なし）。不要なら行ごと消す
#PUBLIC_OPERATOR_BLUESKY_HANDLE=example.com
PUBLIC_PRIVACY_ENACTED_AT=2000-01-01
PUBLIC_PRIVACY_REVISED_AT=2000-01-01
# Google アナリティクスの測定 ID。不要なら行ごと消す
#PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ハッシュタグ履歴の保持上限（正の整数。不正なら 100）
#PUBLIC_HASHTAG_HISTORY_MAX=100

# --- 予約投稿のシークレット ---
# Worker のシークレットは wrangler が .dev.vars から読む（.dev.vars がある間は .env を読まない）。
# 予約投稿をローカルで試すときは、.env ではなく .dev.vars に追記する。
#   SCHEDULE_ENC_KEY   : openssl rand -base64 32
#   SCHEDULE_OAUTH_KEY : node hack/generate-oauth-key.mjs

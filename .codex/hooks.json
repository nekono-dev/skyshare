{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^startup$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/scripts/agent/install-cc-sdd.sh\" --codex",
            "timeout": 600,
            "statusMessage": "Installing cc-sdd"
          },
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/agent/setup-brw.mjs\" --install",
            "timeout": 600
          }
        ]
      }
    ]
  }
}

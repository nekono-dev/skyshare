{
    "name": "skyshare-legacy",
    "compatibility_date": "2026-08-14",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./dist/_worker.js/index.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
    },
    "observability": {
        "enabled": true,
    },
    // v2 Worker(../wrangler.jsonc)と同一ドメインを共有し、/legacy* のパスのみを
    // このWorkerが担当する。Cloudflareのルートは最長一致で振り分けられるため、
    // v2側はこのpatternを意識せず `pattern: "<host>"` のままでよい。
    "routes": [
        {
            "pattern": "preview.skyshare.nekono.dev/legacy*",
            "zone_name": "nekono.dev",
            "custom_domain": false,
        },
        {
            "pattern": "skyshare.nekono.dev/legacy*",
            "zone_name": "nekono.dev",
            "custom_domain": false,
        },
    ],
    "workers_dev": true,
}

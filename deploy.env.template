# 配備に使う設定値の雛形（DEVELOP.md の「フォークして動かす」）。
# リポジトリ直下に deploy.env としてコピーし、値を書き換えてから登録する（deploy.env は .gitignore 対象）。
#   cp deploy.env.template deploy.env
#   npm run deploy:env -- --dry-run   # 登録先と変数名だけを表示する（値は表示しない）
#   npm run deploy:env                # gh と wrangler で登録する
#
# 区分（[...]）ごとに登録先が決まる。値が空の行は登録しない（登録済みの値は変わらない）。
# 値を @<パス> にすると、そのファイルの中身を値にする（例: E2E_ENV=@.env.e2e）。

[github.variables]
# GitHub の Actions の Variables（gh variable set）。CI のビルドと配備設定の生成に使う。

# 公開するドメイン（必須）。Cloudflare に追加済みのゾーン配下のドメインにする
SITE_HOST=skyshare.example.com

# 運営者情報（必須。プライバシーポリシーに載る）
PUBLIC_OPERATOR_NAME=example-operator
PUBLIC_OPERATOR_EMAIL=privacy@example.com
# 窓口の Bluesky ハンドル（任意。@ なし）
PUBLIC_OPERATOR_BLUESKY_HANDLE=example.com
# プライバシーポリシーの制定日と最終改定日（必須。YYYY-MM-DD）
PUBLIC_PRIVACY_ENACTED_AT=2026-01-01
PUBLIC_PRIVACY_REVISED_AT=2026-01-01
# Google アナリティクスの測定 ID（任意）。空にするとタグを出さず、ポリシーにも載らない
PUBLIC_GA_MEASUREMENT_ID=

# アプリの接続先（必須）
PUBLIC_DEFAULT_ATP_SERVICE=https://api.bsky.app
PUBLIC_PLC_DIRECTORY_BASE_URL=https://plc.directory
PUBLIC_OGP_EXTRACTOR_API=https://ogpextractor.example.com
# production にすると Cookie に Secure 属性を付ける
PUBLIC_NODE_ENV=production
# 旧 UI のバックエンド（必須の形式だが、旧 UI を使わないならダミーの URL でよい）
PUBLIC_LEGACY_BACKEND_ENDPOINT=https://backend.example.com/api/v1

[github.secrets]
# GitHub の Actions の Secrets（gh secret set）。
# Cloudflare の API トークン（Edit Cloudflare Workers ＋ D1 編集）とアカウント ID。
# ここに書くと、wrangler での登録にも使う（シェルの環境変数が優先される）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# 仕様書の検査（spec-lint）の取得に使う、read:packages 権限のトークン（任意）
SPEC_LINT_TOKEN=
# 実アカウントのライブテストの設定（任意）
E2E_ENV=

[worker.secrets]
# 本番・develop・プレビューの Worker に同じ値で登録するシークレット（wrangler secret put）。
# 不具合の報告・新機能の提案に使う GitHub の Fine-grained PAT（登録先のリポジトリの Issues: Read and write のみ）
FEEDBACK_GITHUB_TOKEN=

[worker.secrets.production]
# 本番の Worker だけに登録するシークレット。
# 予約投稿の鍵は、替えると保管済みの認証情報が使えなくなるため、登録済みなら空のままにする
SCHEDULE_ENC_KEY=
SCHEDULE_OAUTH_KEY=

[worker.secrets.develop]
# develop とプレビューの Worker に登録するシークレット（D1 を共用するため同じ値にする）。
SCHEDULE_ENC_KEY=
SCHEDULE_OAUTH_KEY=

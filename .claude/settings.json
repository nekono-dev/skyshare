{
  "extraKnownMarketplaces": {
    "nekono-dev": {
      "source": {
        "source": "github",
        "repo": "nekono-dev/claude-plugins"
      }
    }
  },
  "enabledPlugins": {
    "branch-release-workflow@nekono-dev": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/install-cc-sdd.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}

{
  "workBranches": ["dev/*"],
  "protectedBranches": ["main", "develop"],
  "baseBranch": "develop",
  "namePattern": "^dev/[a-z0-9]+(-[a-z0-9]+)*$",
  "maxNameLength": 50,
  "preview": {
    "provider": "cloudflare-previews",
    "urlTemplate": "https://{alias}.develop.skyshare.nekono.dev",
    "aliasStripPrefix": "dev/"
  }
}

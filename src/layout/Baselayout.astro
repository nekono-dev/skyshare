---
/**
 * 全ページ共通の基本レイアウト。
 *
 * 責務と処理概要:
 * - HTML スケルトン（head/body/main）を提供する。
 * - OGP/SEO メタ情報は `Metadatas` へ委譲する。
 * - header/footer は named slot、本文は default slot で受け取る。
 */

interface Props {
    pageTitle: string
    cardPath: string
    robots: string[]
    avatarUrl?: string | null
    pageHeading?: string
    pageCaption?: string
}
import Metadatas from "@/components/Metadatas.astro"
const { cardPath, pageTitle, robots, avatarUrl, pageHeading, pageCaption } = Astro.props
const favicon = "favicon.svg"
import "@/styles/tokens.css"
import styles from "./Baselayout.module.css"
---

<html lang="ja">
    <head>
        <link rel="icon" href={favicon} />
        <Metadatas
            cardPath={cardPath}
            pageTitle={pageTitle}
            robots={robots}
            avatarUrl={avatarUrl}
            pageHeading={pageHeading}
            pageCaption={pageCaption}
        />
    </head>
    <body id="root" class={styles.root}>
        <slot name="header" />
        <main class={styles.content}>
            <slot />
        </main>
        <slot name="footer" />
    </body>
</html>

---
/**
 * 全ページ共通の基本レイアウト。
 *
 * 責務と処理概要:
 * - HTML スケルトン（head/body/main）を提供する。
 * - OGP/SEO メタ情報は `Metadatas` へ委譲する。
 * - header/nav(Sidebar)/footer(FooterNav) は named slot、本文は default slot で受け取る。
 * - nav/footer のいずれかが埋まっているページでは、nav と本文を .shell (CSS Grid) で
 *   包み、サイドバーとタイムラインをひとつの塊として中央寄せする。
 */

interface Props {
    /** 動的なタイトル（Entry名など）。静的ページは `pageTitleKey` を使う。 */
    pageTitle?: string
    /** 静的ページのタイトル文言キー。表示言語で翻訳され、言語切り替え時にも再翻訳される。 */
    pageTitleKey?: MessageKey
    cardPath: string
    robots: string[]
    avatarUrl?: string | null
    pageHeading?: string
    pageCaption?: string
}
import Metadatas from "@/components/layout/Metadatas.astro"
import { createTranslator, type MessageKey } from "@/lib/i18n/translate"
import { serviceName } from "@/vars"
const { cardPath, pageTitle, pageTitleKey, robots, avatarUrl, pageHeading, pageCaption } = Astro.props
const locale = Astro.locals.locale
// SSR 応答の Content-Type に charset が無いと、X のクローラーが meta charset を使わず
// 日本語の OGP タイトルを誤読する恐れがあるため、ヘッダー側でも UTF-8 を明示する。
Astro.response.headers.set("Content-Type", "text/html; charset=utf-8")
// pageTitleKey の文言は `{service}` を含みうるためサービス名を渡す（含まない文言では無視される）。
const resolvedPageTitle =
    pageTitleKey !== undefined
        ? createTranslator(locale).t(pageTitleKey, { service: serviceName } as never)
        : (pageTitle ?? serviceName)
const favicon = "favicon.svg"
import ui from "@/styles/ui.module.css"
import { ClientRouter } from "astro:transitions"

// nav / footer いずれかのスロットが埋められているページのみ、
// フッター/サイドバーナビ用の .shell (Gridレイアウト) を適用し、
// 本文とナビが重ならないよう余白を確保する。
const hasNav = Astro.slots.has("nav") || Astro.slots.has("footer")
const bodyClass = hasNav ? `${ui.root} ${ui["with-nav"]}` : ui.root
---

<html lang={locale}>
    <head>
        <meta charset="utf-8" />
        <script is:inline>
            try {
                const themeMode = localStorage.getItem("themeMode")
                if (themeMode === "light" || themeMode === "dark") {
                    document.documentElement.dataset.theme = themeMode
                }
            } catch (error) {}
            document.addEventListener("astro:before-swap", event => {
                // 表示言語(<html lang>)も data-theme と同様、遷移先がサーバーの返した値で
                // 置き換えてしまうため、遷移前に確定済みの言語をコピーして維持する。
                if (document.documentElement.lang) {
                    event.newDocument.documentElement.lang = document.documentElement.lang
                }
                const currentTheme = document.documentElement.dataset.theme
                if (currentTheme) {
                    event.newDocument.documentElement.dataset.theme = currentTheme
                } else {
                    delete event.newDocument.documentElement.dataset.theme
                }
            })
        </script>
        <link rel="icon" href={favicon} />
        <Metadatas
            cardPath={cardPath}
            pageTitle={resolvedPageTitle}
            pageTitleKey={pageTitleKey}
            robots={robots}
            avatarUrl={avatarUrl}
            pageHeading={pageHeading}
            pageCaption={pageCaption}
        />
        <ClientRouter />
        <script>
            // 表示言語ストアを読み込む（初回・ページ遷移のたびに言語を確定し、静的DOMを書き換える）。
            import "@/lib/i18n/store"
        </script>
        <script>
            /**
             * Entry一覧/ホーム/設定/アカウント切り替えをFooterNavの表示順で横一列
             * （Entry一覧=左, ホーム, 設定, アカウント切り替え=右）とみなし、
             * View Transitionsのslideアニメーションが実際の移動方向（左右）と一致するよう
             * `astro:before-preparation` イベントの `direction` を上書きする。
             *
             * 処理の趣旨:
             * - Astro標準の`direction`はブラウザの戻る/進むボタン（`navigationType === "traverse"`）
             *   でのみ履歴インデックスから正しく算出される。リンククリックによる遷移は常に"forward"
             *   扱いになるため、対象ページ同士の遷移ではここで明示的に上書きする。
             * - 位置(position)はFooterNavの表示順（src/components/layout/nav/navItems.tsの
             *   `footerNavItems`: Entry一覧 → ホーム → 設定 → アカウント）と一致させる必要がある。
             *   ずれると実際のタブ位置とスライド方向が逆になる。
             *
             * Input:
             * - `astro:before-preparation` イベント（`from`/`to`はURL、`direction`は書き換え可能）
             *
             * Output:
             * - なし（イベントの`direction`プロパティを副作用として書き換える）
             */
            const pagePositions: Record<string, number> = {
                "/entries": -1,
                "/": 0,
                "/settings": 1,
                "/accounts": 2,
            }
            const normalizePathname = (pathname: string): string =>
                pathname !== "/" && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname

            document.addEventListener("astro:before-preparation", event => {
                // 戻る/進むボタン操作はAstro標準の履歴インデックス判定に委ねる
                if (event.navigationType === "traverse") return

                const fromPosition = pagePositions[normalizePathname(event.from.pathname)]
                const toPosition = pagePositions[normalizePathname(event.to.pathname)]
                if (fromPosition === undefined || toPosition === undefined || fromPosition === toPosition) return

                event.direction = toPosition > fromPosition ? "forward" : "back"
            })
        </script>
    </head>
    <body id="root" class={bodyClass}>
        <slot name="header" />
        {
            hasNav ? (
                <div class={ui.shell}>
                    <slot name="nav" />
                    <slot />
                </div>
            ) : (
                <slot />
            )
        }
        <slot name="footer" />
    </body>
</html>

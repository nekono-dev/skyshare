---
/**
 * ヘルプページ。
 *
 * 責務と処理概要:
 * - `Help` コンポーネントを表示し、FAQ/利用案内を一覧表示する。
 * - 表示内容は静的なリスト(`helpEntries.tsx`)のみに依存するため、静的配信可能。
 *   prerender を有効化する。
 * - プライバシーポリシー・不具合の報告と同様に、サイドバー・フッターナビを表示しない単独ページとする。
 *   ナビ項目一覧にもこのページを追加しない（リンクは設定ページに置く）。
 *   ナビがないため、設定ページへ戻るリンクを置く。
 */
export const prerender = true
import Help from "@/components/help/Help"
import Baselayout from "@/layout/Baselayout.astro"
import StandaloneFooter from "@/components/layout/StandaloneFooter/index.astro"
import { createTranslator } from "@/lib/i18n/translate"
import ui from "@/styles/ui.module.css"

const { t } = createTranslator(Astro.locals.locale)
const robots = ["noindex", "nofollow", "noarchive", "noimageindex"]
---

<Baselayout cardPath={`/materials/ogp_main.png`} pageTitleKey="pageTitle.help" robots={robots}>
    <div class={ui.center}>
        <div class=`${ui.page} ${ui["width-lg"]} ${ui.center} `>
            <div class={ui["width-lg"]}>
                <h1 class={ui.subject} data-i18n="page.help.heading">{t("page.help.heading")}</h1>
                <Help client:load />
                <div style="margin-bottom: 1rem;">
                    <a href="/settings/" class={ui.text} data-i18n="page.help.back">{t("page.help.back")}</a>
                </div>
            </div>
            <StandaloneFooter />
        </div>
    </div>
</Baselayout>

---
/**
 * ログインページ。
 *
 * 責務と処理概要:
 * - `LoginForm` を表示し、セッション作成導線を提供する。
 * - 静的配信可能なため prerender を有効化する。
 */
export const prerender = true
import LoginForm from "@/components/account/LoginForm"
import LoginIntro from "@/components/account/LoginIntro"
import LocaleSelect from "@/components/common/LocaleSelect"

import Baselayout from "@/layout/Baselayout.astro"
import { serviceName, serviceVersion } from "@/vars"
const robots = ["index", "follow", "noarchive", "noimageindex"]
import ui from "@/styles/ui.module.css"
---

<Baselayout cardPath={`/materials/ogp_main.png`} pageTitleKey="pageTitle.login" robots={robots}>
    <div class={ui.center}>
        <div class=`${ui.page} ${ui["width-lg"]} ${ui.center}`>
            <img class={ui["width-lg"]} src="/materials/longlogo.svg" alt={serviceName} />
            <div class=`${ui.left} ${ui["self-end"]} ${ui.subject}`>v{serviceVersion}</div>
            <div class=`${ui["width-md"]}`>
                <div class={ui.right} style="margin: 0.5rem 0;">
                    <LocaleSelect client:load showLabel />
                </div>
                {
                    /* LoginForm 自体が base-card のため、入れ子にしない（カードの入れ子だとパスワードマネージャーが入力欄を検出できない） */
                }
                <LoginForm client:load />
                <LoginIntro client:load />
            </div>
            <div style="margin: 1rem;">2025-2026 © Skyshare</div>
        </div>
    </div></Baselayout
>

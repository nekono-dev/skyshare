---
/**
 * ログインページ。
 *
 * 責務と処理概要:
 * - `LoginForm` を表示し、セッション作成導線を提供する。
 * - 静的配信可能なため prerender を有効化する。
 */
export const prerender = true
import LoginForm from "@/components/LoginForm"

import Baselayout from "@/layout/Baselayout.astro"
import { serviceName, serviceVersion } from "@/vars"
const robots = ["index", "follow", "noarchive", "noimageindex"]
import ui from "@/styles/ui.module.css"
---

<Baselayout cardPath={`/materials/ogp_main.png`} pageTitle={serviceName} robots={robots}>
    <div class={ui.center}>
        <div class=`${ui.page} ${ui.pageWidth} ${ui.center}`>
            <img class={ui.pageWidth} src="/materials/longlogo.svg" alt={serviceName} />
            <div class=`${ui.left} ${ui.selfEnd} ${ui.subject}`>v{serviceVersion}</div>
            <div class=`${ui.componentWidth}`>
                <LoginForm client:load />
            </div>
        </div>
    </div>
</Baselayout>

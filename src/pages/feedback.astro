---
/**
 * 不具合の報告・新機能の提案のページ。`FeedbackForm` が、ログイン中の利用者の内容を GitHub の Issue として送る。
 *
 * - ログインの確認と送信は画面側で行い、ページは辞書だけに依存するため prerender する。
 * - サイドバー・フッターナビを出さない単独ページで、ナビ項目一覧にも加えない（リンクは設定ページのヘルプの下）。
 *   ナビがないため、設定ページへ戻るリンクを置く。
 */
export const prerender = true
import FeedbackForm from "@/components/feedback/FeedbackForm"
import Baselayout from "@/components/layout/Baselayout/index.astro"
import StandaloneFooter from "@/components/layout/StandaloneFooter/index.astro"
import { createTranslator } from "@/lib/i18n/translate"
import ui from "@/styles/ui.module.css"

const { t } = createTranslator(Astro.locals.locale)
const robots = ["noindex", "nofollow", "noarchive", "noimageindex"]
---

<Baselayout cardPath={`/materials/ogp_main.png`} pageTitleKey="pageTitle.feedback" robots={robots}>
    <div class={ui.center}>
        <div class=`${ui.page} ${ui["width-lg"]} ${ui.center} `>
            <div class={ui["width-lg"]}>
                <h1 class={ui.subject} data-i18n="feedback.heading">{t("feedback.heading")}</h1>
                <FeedbackForm client:load />
                <div style="margin-bottom: 1rem;">
                    <a href="/settings/" class={ui.text} data-i18n="feedback.back">{t("feedback.back")}</a>
                </div>
            </div>
            <StandaloneFooter />
        </div>
    </div>
</Baselayout>

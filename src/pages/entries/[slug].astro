---
/**
 * Skyshare エントリ詳細ページ（SSR）。
 *
 * 責務と処理概要:
 * - URL slug からエントリ識別子を解析し、PDS 上の skyshare レコードを取得する。
 * - 元投稿情報（本文・画像）を取得してページ表示用データへ整形する。
 * - 取得失敗時は HTTP ステータスと理由を切り替えてエラーページを返す。
 *
 * 実装上の制約:
 * - Cloudflare Workers 環境で動作するため Node.js 固有 API は利用しない。
 */

export const prerender = false

import ui from "@/styles/ui.module.css"
import LocaleSelect from "@/components/common/LocaleSelect"
import type { PlainMessageKey } from "@/lib/i18n/translate"
import { AtpAgent, AppBskyFeedDefs, AppBskyFeedPost } from "@atproto/api"
import Baselayout from "@/layout/Baselayout.astro"
import EntryDetailView from "@/components/entry/EntryDetailView/index.astro"
import type { EntryPostView } from "@/components/entry/EntryDetailView/index.astro"
import { serviceName } from "@/vars"
import { atpService } from "@/env"
import { bskyPostUrlgen, parseAtUri } from "@/lib/entry/url"
import { resolvePdsServiceForDid } from "@/lib/atproto/did"
import { parseEntryLocator, blobToCdnUrl, extractSourceImages, extractEmbedVideo, extractUnsupportedEmbedVideo, ENTRY_COLLECTION } from "@/lib/entry/entry"
import type { EntryLike } from "@/lib/entry/entry"
import { resolveXrpcStatus } from "@/lib/api/response"
import { extractOwnedLinearReplyChain } from "@/lib/atproto/threadChain"
import { MAX_THREAD_POST_COUNT } from "@/lib/atproto/threadLimit"

const robots = ["index", "follow", "noarchive", "noimageindex"]

const slug = Astro.params.slug

// PostView（AppView算出のリアクション数を含む）から、投稿カード1件分の表示用データを作る。
// リアクション数は各投稿自身の値（数値でなければ 0）を使う（specs/postcardlayout/design.md §2.2）。
const toEntryPostView = (post: AppBskyFeedDefs.PostView, repoDid: string, webUrl: string): EntryPostView => {
    const record = post.record as AppBskyFeedPost.Main
    const count = (value: unknown) => (typeof value === "number" ? value : 0)
    return {
        webUrl,
        author: {
            handle: post.author.handle,
            displayName: post.author.displayName,
            avatar: post.author.avatar,
        },
        createdAt: record.createdAt,
        text: record.text,
        images: extractSourceImages(record, repoDid),
        video: extractEmbedVideo(record.embed, repoDid),
        unsupportedVideo: extractUnsupportedEmbedVideo(record.embed, repoDid),
        engagement: {
            likeCount: count(post.likeCount),
            repostCount: count(post.repostCount),
            replyCount: count(post.replyCount),
            quoteCount: count(post.quoteCount),
        },
    }
}

let statusCode = 200
let pageTitle = `${serviceName} Entry`
let cardPath = ""
let sourceWebUrl = ""
let sourceText = ""
let createdAt = ""
let posts: EntryPostView[] = []
let manifestHeading = ""
let manifestCaption = ""
let metaDescription = ""
let notFoundReasonKey: PlainMessageKey = "entry.detail.error404Body"
let sourcePostAvailable = true

// 入力パラメータ検証→レコード取得→表示用整形の順で段階的に失敗点を切り分ける。
if (typeof slug === "undefined") {
    statusCode = 404
    notFoundReasonKey = "entry.detail.error404Body"
} else {
    const locator = parseEntryLocator(slug)

    if (!locator) {
        statusCode = 404
        notFoundReasonKey = "entry.detail.error404Body"
    } else {
        const agent = new AtpAgent({ service: atpService })
        console.debug(`service: ${atpService}, locator: ${JSON.stringify(locator)}`)
        try {
            const did = locator.actor
            const pdsService = await resolvePdsServiceForDid(did)
            if (!pdsService) {
                statusCode = 500
                console.warn("entries/[slug] SSR failed", {
                    reason: "failed to resolve pds endpoint",
                    slug,
                    did,
                })
                return 500
            }
            console.debug(`resolved PDS service for DID ${did}: ${pdsService}`)

            const recordAgent = new AtpAgent({ service: pdsService })

            const recordRes = await recordAgent.com.atproto.repo.getRecord({
                repo: did,
                collection: ENTRY_COLLECTION,
                rkey: locator.rkey,
            })

            const parsedEntryUri = parseAtUri(recordRes.data.uri)
            const entryRepoDid = parsedEntryUri?.repo ?? did
            const entry = recordRes.data.value as EntryLike

            const sourceUriFromEntry =
                typeof entry.source?.uri === "string"
                    ? entry.source.uri
                    : typeof entry.manifest?.source?.uri === "string"
                      ? entry.manifest.source.uri
                      : ""

            if (!sourceUriFromEntry) {
                statusCode = 404
                notFoundReasonKey = "entry.detail.errorInvalid"
                return 404
            }
            const parsedSourceUri = parseAtUri(sourceUriFromEntry)

            // サービス種別ごとに表示先URLを切り替える拡張ポイント。
            // 現状は bsky 投稿のみ許可し、未知コレクションは無効データとして扱う。
            switch (parsedSourceUri?.collection) {
                case "app.bsky.feed.post":
                    sourceWebUrl = bskyPostUrlgen(did, parsedSourceUri.rkey)
                    break
                default:
                    statusCode = 500
                    notFoundReasonKey = "entry.detail.errorInvalid"
                    return 500
            }

            createdAt = typeof entry.createdAt === "string" ? entry.createdAt : ""

            manifestHeading = typeof entry.manifest?.heading === "string" ? (entry.manifest as any).heading : ""
            manifestCaption = typeof entry.manifest?.caption === "string" ? (entry.manifest as any).caption : ""

            const manifestVisualUrl = blobToCdnUrl(entryRepoDid, entry.manifest?.visual)
            if (manifestVisualUrl) {
                cardPath = manifestVisualUrl
            }

            if (manifestHeading) {
                pageTitle = `${manifestHeading} | ${serviceName}`
            }

            // PostView（AppView算出のリアクション数を含む）を1回のバッチ取得APIで取得する。
            // 生レコード取得用の agent.getPost（com.atproto.repo.getRecord）は
            // PostView の上位互換情報を持たないため、こちらに一本化している。
            const postsRes = await agent.getPosts({ uris: [sourceUriFromEntry] })
            const postView = postsRes.data.posts[0]
            if (postView) {
                const sourcePostRecord = postView.record as AppBskyFeedPost.Main

                sourceText = sourcePostRecord.text
                // 単発（またはスレッド抽出失敗時のフォールバック）は source 投稿1件分のカードにする。
                posts = [toEntryPostView(postView, parsedSourceUri.repo, sourceWebUrl)]

                // source投稿を起点に、entry所有者自身が投稿した後続投稿のみを直線的に辿る
                // （specs/entry/frontend/design.md §3.3）。取得・抽出に失敗しても500にはせず、
                // 単一投稿のカード表示へフォールバックする。
                try {
                    const threadRes = await agent.app.bsky.feed.getPostThread({
                        uri: sourceUriFromEntry,
                        depth: MAX_THREAD_POST_COUNT,
                    })
                    if (AppBskyFeedDefs.isThreadViewPost(threadRes.data.thread)) {
                        const chain = extractOwnedLinearReplyChain(
                            threadRes.data.thread,
                            entryRepoDid,
                            MAX_THREAD_POST_COUNT,
                        )
                        if (chain.length > 1) {
                            posts = chain.map(post => {
                                const parsedPostUri = parseAtUri(post.uri)
                                return toEntryPostView(
                                    post,
                                    entryRepoDid,
                                    parsedPostUri ? bskyPostUrlgen(did, parsedPostUri.rkey) : sourceWebUrl,
                                )
                            })
                        }
                    }
                } catch (error) {
                    console.warn("entries/[slug] SSR: failed to fetch thread", {
                        reason: error instanceof Error ? error.message : String(error),
                        slug,
                    })
                }
            } else {
                // 元投稿が削除済み等で AppView から取得できない場合は、500 にはせず
                // entry に保存された manifest 情報のみで表示する。
                sourcePostAvailable = false
            }

            // メタ情報の説明文だけは、Entry自体のキャプションが無い場合に本文で補う。
            // ヘッダーカードに本文が二重表示されないよう manifestCaption とは分離する。
            metaDescription = manifestCaption || sourceText.slice(0, 280)
        } catch (error) {
            // entry レコード自体が見つからない場合（削除済み等）は RecordNotFound として
            // 404 を返す。source の Bluesky 投稿が見つからない場合は上の getPosts 分岐で
            // sourcePostAvailable = false として処理するため、ここには到達しない。
            statusCode = resolveXrpcStatus(error)
            if (statusCode === 404) {
                notFoundReasonKey = "entry.detail.error404Body"
            }
            console.warn("entries/[slug] SSR failed", {
                reason: error instanceof Error ? error.message : String(error),
                slug,
                statusCode,
            })
        }
    }
}

Astro.response.status = statusCode
---

<Baselayout
    cardPath={cardPath}
    pageTitle={pageTitle}
    pageHeading={manifestHeading}
    pageCaption={metaDescription}
    robots={robots}
>
    <div class={ui.center}>
        <div class={`${ui.page} ${ui["width-lg"]}`}>
            <div class={ui["self-end"]}>
                <LocaleSelect client:load showLabel />
            </div>
            <EntryDetailView
                statusCode={statusCode}
                notFoundReasonKey={notFoundReasonKey}
                heading={manifestHeading}
                caption={manifestCaption}
                createdAt={createdAt}
                sourcePostAvailable={sourcePostAvailable}
                sourceUrl={sourceWebUrl}
                visualUrl={cardPath}
                posts={posts}
            />
        </div>
    </div>
</Baselayout>

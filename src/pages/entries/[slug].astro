---
/**
 * Skyshare エントリ詳細ページ（SSR）。
 *
 * 責務と処理概要:
 * - URL slug からエントリ識別子を解析し、PDS 上の skyshare レコードを取得する。
 * - 元投稿情報（本文・画像）を取得してページ表示用データへ整形する。
 * - 取得失敗時は HTTP ステータスと理由を切り替えてエラーページを返す。
 *
 * 実装上の制約:
 * - Cloudflare Workers 環境で動作するため Node.js 固有 API は利用しない。
 */

export const prerender = false

import { AppBskyEmbedImages, AppBskyFeedPost, AtpAgent } from "@atproto/api"
import Baselayout from "@/layout/Baselayout.astro"
import { serviceName } from "@/vars"
import styles from "./[slug].module.css"
import { atpService } from "@/env"
import { bskyPostUrlgen, bskyCdnUrlgen, parseAtUri } from "@/lib/url"
import { resolvePdsServiceForDid } from "@/lib/did"

type SourceLocator = {
    actor: string
    rkey: string
}

type EntryLike = {
    source?: {
        uri?: string
    }
    manifest?: {
        source?: {
            uri?: string
        }
        visual?: {
            ref?: unknown
            mimeType?: string
        }
        heading?: string
        caption?: string
    }
    createdAt?: string
}

type SourceImage = {
    url: string
    alt: string
}

const ENTRY_COLLECTION = "dev.nekono.skyshare.entry"
const robots = ["index", "follow", "noarchive", "noimageindex"]

const DID_PATTERN = /^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$/i

/**
 * DID 形式の識別子か判定する。
 *
 * Input:
 * - `value`: 判定対象文字列
 *
 * Output:
 * - DID 形式なら `true`
 *
 * 例:
 * - 入力: `"did:plc:abc"`
 * - 出力: `true`
 */
const isDidIdentifier = (value: string): boolean => {
    return DID_PATTERN.test(value)
}

/**
 * slug 文字列をエントリ取得用ロケータへ変換する。
 *
 * 想定する入力形状(最小要件):
 * - URL 形式、at:// 形式、`did@rkey` 形式のいずれか
 *
 * 処理の趣旨:
 * - 複数入力形式を許容しつつ、最終的に `{ actor, rkey }` へ正規化する。
 * - DID でない actor は除外し、無効入力は `undefined` を返す。
 *
 * Input:
 * - `slugValue`: パスパラメータ
 *
 * Output:
 * - 成功時: `SourceLocator`
 * - 失敗時: `undefined`
 *
 * 例:
 * - 入力: `"did:plc:abc@3lxyz"`
 * - 出力: `{ actor: "did:plc:abc", rkey: "3lxyz" }`
 */
const parseEntryLocator = (slugValue: string): SourceLocator | undefined => {
    const decoded = decodeURIComponent(slugValue)

    if (decoded.startsWith("http://") || decoded.startsWith("https://")) {
        const url = new URL(decoded)
        // 自アプリの共有URL形式 `/entries/{did@rkey}` を許容する。
        const parts = url.pathname.split("/").filter(Boolean)
        if (parts.length >= 2 && parts[0] === "entries") {
            const compact = parts[1].match(/^([^@]+)@([^@/]+)$/)
            if (compact) {
                if (!isDidIdentifier(compact[1])) {
                    return
                }
                return { actor: compact[1], rkey: compact[2] }
            }
        }
        return
    }

    if (decoded.startsWith("at://")) {
        const match = decoded.match(/^at:\/\/([^/]+)\/dev\.nekono\.skyshare\.entry\/([^/?#]+)$/)
        if (!match) return
        if (!isDidIdentifier(match[1])) return
        return { actor: match[1], rkey: match[2] }
    }

    const compact = decoded.match(/^([^@]+)@([^@/]+)$/)
    if (compact) {
        if (!isDidIdentifier(compact[1])) return
        return { actor: compact[1], rkey: compact[2] }
    }
    return
}

/**
 * Blob 参照値から CID 文字列を抽出する。
 *
 * 想定する入力形状(最小要件):
 * - 文字列 CID
 * - もしくは `$link` / `toString()` を持つオブジェクト
 *
 * Input:
 * - `ref`: Blob 参照の生値
 *
 * Output:
 * - 抽出できた CID 文字列、失敗時は `undefined`
 *
 * 例:
 * - 入力: `{ $link: "bafkre..." }`
 * - 出力: `"bafkre..."`
 */
const toCidString = (ref: unknown): string | undefined => {
    if (typeof ref === "string") return ref
    if (ref && typeof ref === "object") {
        const maybeLink = (ref as Record<string, unknown>)["$link"]
        if (typeof maybeLink === "string") return maybeLink
        if (typeof (ref as { toString?: () => string }).toString === "function") {
            const value = (ref as { toString: () => string }).toString()
            if (typeof value === "string" && value.length > 0 && value !== "[object Object]") {
                return value
            }
        }
    }
    return
}

/**
 * レコード内 Blob 情報を Bluesky CDN URL へ変換する。
 *
 * Input:
 * - `repoDid`: 対象 repo DID
 * - `blob`: `ref` と `mimeType` を持つ可能性があるオブジェクト
 *
 * Output:
 * - CDN URL 文字列、抽出失敗時は `undefined`
 *
 * 例:
 * - 入力: `(did, { ref: { $link: "baf..." } })`
 * - 出力: `https://cdn.bsky.app/...`
 */
const blobToCdnUrl = (
    repoDid: string,
    blob?: {
        ref?: unknown
        mimeType?: string
    },
): string | undefined => {
    if (!blob) return
    const ref = toCidString(blob.ref)
    if (!ref) return
    return bskyCdnUrlgen(repoDid, ref)
}

/**
 * 投稿レコードから画像埋め込みを抽出して表示用配列へ変換する。
 *
 * Input:
 * - `postRecord`: app.bsky.feed.post レコード
 * - `sourceRepoDid`: 画像解決用 repo DID
 *
 * Output:
 * - 表示用 `SourceImage[]`
 *
 * 例:
 * - 入力: images embed を持つ投稿
 * - 出力: `{ url, alt }` 配列
 */
const extractSourceImages = (postRecord: AppBskyFeedPost.Main, sourceRepoDid: string): SourceImage[] => {
    const embedded = postRecord.embed

    const fromImagesRecord = (imagesRecord: AppBskyEmbedImages.Main): SourceImage[] => {
        if (!imagesRecord || !Array.isArray(imagesRecord.images)) return []
        return imagesRecord.images
            .map(img => {
                const url = blobToCdnUrl(sourceRepoDid, img.image)
                if (!url) return
                return {
                    url,
                    alt: typeof img?.alt === "string" ? img.alt : "",
                }
            })
            .filter((img): img is SourceImage => img !== undefined)
    }

    if (embedded?.$type === "app.bsky.embed.images") {
        return fromImagesRecord(embedded as AppBskyEmbedImages.Main)
    }

    return []
}

const slug = Astro.params.slug

let statusCode = 200
let pageTitle = `${serviceName} Entry`
let cardPath = ""
let sourceWebUrl = ""
let sourceText = ""
let sourceImages: SourceImage[] = []
let createdAtText = ""
let manifestHeading = ""
let manifestCaption = ""
let notFoundReason = "entry not found"

// 入力パラメータ検証→レコード取得→表示用整形の順で段階的に失敗点を切り分ける。
if (typeof slug === "undefined") {
    statusCode = 404
    notFoundReason = "Entry is not found"
} else {
    const locator = parseEntryLocator(slug)

    if (!locator) {
        statusCode = 404
        notFoundReason = "Entry is not found"
    } else {
        const agent = new AtpAgent({ service: atpService })
        console.debug(`service: ${atpService}, locator: ${JSON.stringify(locator)}`)
        try {
            const did = locator.actor
            const pdsService = await resolvePdsServiceForDid(did)
            if (!pdsService) {
                statusCode = 500
                console.warn("entries/[slug] SSR failed", {
                    reason: "failed to resolve pds endpoint",
                    slug,
                    did,
                })
                return
            }
            console.debug(`resolved PDS service for DID ${did}: ${pdsService}`)

            const recordAgent = new AtpAgent({ service: pdsService })

            const recordRes = await recordAgent.com.atproto.repo.getRecord({
                repo: did,
                collection: ENTRY_COLLECTION,
                rkey: locator.rkey,
            })

            const parsedEntryUri = parseAtUri(recordRes.data.uri)
            const entryRepoDid = parsedEntryUri?.repo ?? did
            const entry = recordRes.data.value as EntryLike

            const sourceUriFromEntry =
                typeof entry.source?.uri === "string"
                    ? entry.source.uri
                    : typeof entry.manifest?.source?.uri === "string"
                      ? entry.manifest.source.uri
                      : ""

            if (!sourceUriFromEntry) {
                statusCode = 404
                notFoundReason = "Invalid skyshare entry"
                return
            }
            const parsedSourceUri = parseAtUri(sourceUriFromEntry)

            // サービス種別ごとに表示先URLを切り替える拡張ポイント。
            // 現状は bsky 投稿のみ許可し、未知コレクションは無効データとして扱う。
            switch (parsedSourceUri?.collection) {
                case "app.bsky.feed.post":
                    sourceWebUrl = bskyPostUrlgen(did, parsedSourceUri.rkey)
                    break
                default:
                    statusCode = 500
                    notFoundReason = "Invalid skyshare entry"
                    return
            }

            createdAtText =
                typeof entry.createdAt === "string"
                    ? new Date(entry.createdAt).toLocaleString("ja-JP", {
                          dateStyle: "medium",
                          timeStyle: "short",
                      })
                    : ""

            manifestHeading = typeof entry.manifest?.heading === "string" ? entry.manifest.heading : ""
            manifestCaption = typeof entry.manifest?.caption === "string" ? entry.manifest.caption : ""

            const manifestVisualUrl = blobToCdnUrl(entryRepoDid, entry.manifest?.visual)
            if (manifestVisualUrl) {
                cardPath = manifestVisualUrl
            }

            if (manifestHeading) {
                pageTitle = `${manifestHeading} | ${serviceName}`
            }

            const postRes = await agent.getPost({
                repo: parsedSourceUri.repo,
                rkey: parsedSourceUri.rkey,
            })
            const sourcePostRecord = postRes.value

            sourceText = sourcePostRecord.text
            sourceImages = extractSourceImages(sourcePostRecord, parsedSourceUri.repo)

            if (!manifestCaption && sourceText) {
                manifestCaption = sourceText.slice(0, 280)
            }
        } catch (error) {
            statusCode = 500
            console.warn("entries/[slug] SSR failed", {
                reason: error instanceof Error ? error.message : String(error),
                slug,
            })
        }
    }
}

Astro.response.status = statusCode
---

<Baselayout
    cardPath={cardPath}
    pageTitle={pageTitle}
    pageHeading={manifestHeading}
    pageCaption={manifestCaption}
    robots={robots}
>
    {
        statusCode === 200 ? (
            <article class={styles.container}>
                <header>
                    <h1 class={styles.heading}>{manifestHeading}</h1>
                </header>

                {manifestCaption ? <p class={styles.bodyText}>{manifestCaption}</p> : null}

                <dl class={styles.metaList}>
                    <div>
                        <a href={sourceWebUrl} rel="noopener noreferrer" target="_blank">
                            Blueskyの投稿を見る
                        </a>
                    </div>
                    <div>投稿日時: {createdAtText ? createdAtText : "no data"}</div>
                </dl>

                {sourceImages.length > 0 ? (
                    <section class={styles.imageGrid} aria-label="source images">
                        {sourceImages.map(image => (
                            <figure class={styles.imageCard}>
                                <img src={image.url} alt={image.alt} loading="lazy" decoding="async" />
                                {image.alt ? <figcaption>{image.alt}</figcaption> : null}
                            </figure>
                        ))}
                    </section>
                ) : (
                    <p class={styles.emptyMessage}>画像はありません。</p>
                )}
            </article>
        ) : (
            <section class={styles.errorPane}>
                <h1>
                    {statusCode === 404
                        ? "Entry Not Found"
                        : statusCode === 503
                          ? "Service Temporarily Unavailable"
                          : "Internal Server Error"}
                </h1>
                <p>
                    {statusCode === 404
                        ? notFoundReason
                        : statusCode === 503
                          ? "データ取得が混み合っています。しばらくして再度お試しください。"
                          : "ページの生成中にエラーが発生しました。"}
                </p>
            </section>
        )
    }
</Baselayout>

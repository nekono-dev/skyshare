---
/**
 * Entry 一覧ページ。`EntryList` で作成した Skyshare Entry を一覧・編集・削除する。
 *
 * - 参照先の Bluesky 投稿が削除された（孤立した）Entry は、`EntryList`・`EntryCard` が背景色を変えて示す。
 * - 実データは Cookie に依存するため、prerender した上でクライアントが `GET /v2/entries/skyshare` で取得する。
 */
export const prerender = true
import EntryList from "@/components/entry/EntryList"
import Baselayout from "@/components/layout/Baselayout/index.astro"
import FooterNav from "@/components/layout/FooterNav/index.astro"
import Sidebar from "@/components/layout/Sidebar/index.astro"
import { createTranslator } from "@/lib/i18n/translate"
import ui from "@/styles/ui.module.css"
import { slide } from "astro:transitions"

const { t } = createTranslator(Astro.locals.locale)
const robots = ["noindex", "nofollow", "noarchive", "noimageindex"]
---

<Baselayout cardPath={`/materials/ogp_main.png`} pageTitleKey="pageTitle.entries" robots={robots}>
    <div class={ui.center} transition:name="page-slide" transition:animate={slide()}>
        <div class=`${ui["width-lg"]}`>
            <h1 class={ui.subject} style="margin-top: 1rem;" data-i18n="page.entries.heading">
                {t("page.entries.heading")}
            </h1>

            <EntryList client:load />
        </div>
    </div>
    <Sidebar slot="nav" />
    <FooterNav slot="footer" />
</Baselayout>

---
/**
 * ゲストモード（`?guest`、`@/lib/guestMode`参照）の「Entryを開く」からアクセスできる、
 * Playwrightのヘッドレスブラウザ確認用のサンプルEntry詳細ページ（スレッド由来entry）。
 *
 * 責務と処理概要:
 * - `entries/[slug].astro`が投稿2件以上のスレッドを描画する場合の `EntryDetailView` を、
 *   実際のPDSレコード・ログインに依存せず確認できるようにする。
 * - 投稿カードごとに異なるリアクション数・画像枚数（1/3/5枚）を持たせ、
 *   Playwright e2e（`tests/e2e/entryThreadDetail.spec.ts`・`entryPostCards.spec.ts`・`imageGallery.spec.ts`）が使う。
 * - サンプルページはこの`entries/sample.astro`1枚に集約している（状態別の追加ページは作らない）。
 */
export const prerender = true

import ui from "@/styles/ui.module.css"
import LocaleSelect from "@/components/common/LocaleSelect"
import Baselayout from "@/layout/Baselayout.astro"
import EntryDetailView from "@/components/entry/EntryDetailView/index.astro"
import type { EntryPostView } from "@/components/entry/EntryDetailView/index.astro"
import type { SourceImage } from "@/lib/entry/entry"
import { serviceName } from "@/vars"

const robots = ["noindex", "nofollow", "noarchive", "noimageindex"]

const heading = "サンプルスレッドEntry"
const caption = "5件の投稿からなるスレッドのサンプル表示です。"

const author = { handle: "guest.demo", displayName: "ゲストユーザー" }

/** サンプル画像を縦横比つきで n 枚（cid は枚数ごとに別）作る */
const sampleImages = (prefix: string, ratios: [number, number][]): SourceImage[] =>
    ratios.map(([width, height], i) => ({
        url: "/materials/sample-og.png",
        alt: `${prefix}の画像${i + 1}`,
        cid: `bafkreisample${prefix}${i + 1}`,
        aspectRatio: { width, height },
    }))

const posts: EntryPostView[] = [
    {
        webUrl: "https://bsky.app/profile/guest.demo/post/threadsample1",
        author,
        createdAt: "2026-09-06T10:00:00.000Z",
        text: "スレッド1件目（先頭投稿）です。画像が1枚付いています。",
        images: sampleImages("one", [[1200, 630]]),
        engagement: { likeCount: 11, repostCount: 1, replyCount: 2, quoteCount: 0 },
    },
    {
        webUrl: "https://bsky.app/profile/guest.demo/post/threadsample2",
        author,
        createdAt: "2026-09-06T10:01:00.000Z",
        text: "スレッド2件目です。画像が3枚付いています。",
        images: sampleImages("three", [
            [1200, 630],
            [600, 800],
            [1000, 1000],
        ]),
        engagement: { likeCount: 22, repostCount: 4, replyCount: 5, quoteCount: 1 },
    },
    {
        webUrl: "https://bsky.app/profile/guest.demo/post/threadsample3",
        author,
        createdAt: "2026-09-06T10:02:00.000Z",
        text: "スレッド3件目です。画像が5枚付いています。",
        images: sampleImages("five", [
            [1200, 630],
            [600, 800],
            [1000, 1000],
            [800, 600],
            [400, 900],
        ]),
        engagement: { likeCount: 33, repostCount: 6, replyCount: 7, quoteCount: 2 },
    },
    {
        webUrl: "https://bsky.app/profile/guest.demo/post/threadsample4",
        author,
        createdAt: "2026-09-06T10:03:00.000Z",
        text: "スレッド4件目です。動画が付いています。",
        images: [],
        video: {
            cid: "bafkreisamplevideo",
            // 実在しない再生URL（再生に失敗しても、ページは壊れずエラー表示になる）
            playlistUrl: "https://video.bsky.app/watch/did%3Aplc%3Aguestdemo/bafkreisamplevideo/playlist.m3u8",
            thumbnailUrl: "/materials/sample-video-poster.png",
            alt: "サンプル動画",
            aspectRatio: { width: 16, height: 9 },
        },
        engagement: { likeCount: 44, repostCount: 8, replyCount: 9, quoteCount: 3 },
    },
    {
        webUrl: "https://bsky.app/profile/guest.demo/post/threadsample5",
        author,
        createdAt: "2026-09-06T10:04:00.000Z",
        text: "スレッド5件目（末尾投稿）です。引用投稿に添付された、再生できない動画が付いています。",
        images: [],
        unsupportedVideo: {
            cid: "bafkreisampleunsupportedvideo",
            playlistUrl:
                "https://video.bsky.app/watch/did%3Aplc%3Aguestdemo/bafkreisampleunsupportedvideo/playlist.m3u8",
            thumbnailUrl: "/materials/sample-video-poster.png",
            alt: "サンプル動画",
            aspectRatio: { width: 16, height: 9 },
        },
        engagement: { likeCount: 55, repostCount: 10, replyCount: 11, quoteCount: 4 },
    },
]

const createdAt = "2026-09-06T10:00:00.000Z"

const pageTitle = `${heading} | ${serviceName}`
---

<Baselayout
    cardPath="/materials/sample-og.png"
    pageTitle={pageTitle}
    pageHeading={heading}
    pageCaption={caption}
    robots={robots}
>
    <div class={ui.center}>
        <div class={`${ui.page} ${ui["width-lg"]}`}>
            <div class={ui["self-end"]}>
                <LocaleSelect client:load showLabel />
            </div>
            <EntryDetailView
                statusCode={200}
                heading={heading}
                caption={caption}
                createdAt={createdAt}
                sourcePostAvailable={true}
                sourceUrl="https://bsky.app/profile/example.com/post/sample"
                visualUrl="/materials/sample-og.png"
                posts={posts}
            />
        </div>
    </div>
</Baselayout>

---
// Entry submission page
export const prerender = false
import { ComAtprotoServerRefreshSession } from "@/client/atproto"

import { parseSessionFromRequest, makeSessionSetCookie } from "@/lib/cookies.js"
import PostForm from "@/components/PostForm"
import { AtpBaseClient } from "@/client/atproto"

let session: ComAtprotoServerRefreshSession.OutputSchema
let service: string
;({ session, service } = parseSessionFromRequest(Astro.request))
if (session) {
    try {
        const agent = new AtpBaseClient(service)
        const data = await agent.com.atproto.server
            .refreshSession(undefined, {
                headers: { authorization: `Bearer ${session.refreshJwt}` },
            })
            .then(res => res.data)
        // セッションを更新できたらリスポンスのクッキーに付与して送信する
        const cookie = makeSessionSetCookie({ session: data, service })
        Astro.response.headers.set("Set-Cookie", cookie)
        console.log("Session resumed successfully")
    } catch (err) {
        console.error("Failed to resume session:", err)
        return Astro.redirect("/login")
    }
} else {
    // セッションが無い場合は投稿ページへリダイレクト
    return Astro.redirect("/login")
}

import Baselayout from "@/layout/Baselayout.astro"
const robots = ["index", "follow", "noarchive", "noimageindex"]
---

<Baselayout cardPath={`/materials/ogp_main.png`} pageTitle="Skyshare" robots={robots}>
    <PostForm client:load />
</Baselayout>

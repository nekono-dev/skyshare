---
/**
 * 投稿フォームを常時表示するページ。
 *
 * 責務と処理概要:
 * - 投稿一覧は表示せず、PostForm を単独でマウントする。
 * - セッション復元・未ログイン時のリダイレクトは PostPage（クライアント側）が
 *   `/v2/bsky/session` 経由で行う。
 */
export const prerender = true
import Baselayout from "@/layout/Baselayout.astro"
import FooterNav from "@/components/layout/FooterNav/index.astro"
import Sidebar from "@/components/layout/Sidebar/index.astro"
import PostPage from "@/components/post/PostPage"
import ui from "@/styles/ui.module.css"
import { slide } from "astro:transitions"

const robots = ["index", "follow", "noarchive", "noimageindex"]
---

<Baselayout cardPath={`/materials/ogp_main.png`} pageTitle="投稿 - Skyshare" robots={robots}>
    <div class=`${ui["page"]} ${ui["center"]}` transition:name="page-slide" transition:animate={slide()}>
        <div class=`${ui["width-lg"]} ${ui["page-padding"]}`>
            <PostPage client:load />
        </div>
    </div>
    <Sidebar slot="nav" />
    <FooterNav slot="footer" />
</Baselayout>

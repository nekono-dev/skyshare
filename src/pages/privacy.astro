---
/**
 * プライバシーポリシーのページ。
 *
 * 責務と処理概要:
 * - `PolicyCards` を表示し、取り扱う個人情報・利用目的・外部送信・保存期間・利用者の権利を示す。
 * - 本文は辞書と定数のみに依存するため、静的配信可能。prerender を有効化する。
 * - ログインなしで開け、検索エンジンへの公開を許す。
 * - サイドバー・フッターナビは表示するが、ナビ項目一覧にはこのページを追加しない
 *   （リンクは設定・ログイン・予約の認証情報の登録フォームに置く）。
 */
export const prerender = true
import PolicyCards from "@/components/privacy/PolicyCards"
import Baselayout from "@/layout/Baselayout.astro"
import FooterNav from "@/components/layout/FooterNav/index.astro"
import Sidebar from "@/components/layout/Sidebar/index.astro"
import { createTranslator } from "@/lib/i18n/translate"
import ui from "@/styles/ui.module.css"
import { slide } from "astro:transitions"

const { t } = createTranslator(Astro.locals.locale)
const robots = ["index", "follow", "noarchive", "noimageindex"]
---

<Baselayout cardPath={`/materials/ogp_main.png`} pageTitleKey="pageTitle.privacy" robots={robots}>
    <div class={ui.center} transition:name="page-slide" transition:animate={slide()}>
        <div class=`${ui.page} ${ui["width-lg"]} ${ui.center} `>
            <div class=`${ui["width-lg"]} ${ui["footer-nav-spacing"]}`>
                <h1 class={ui.subject} data-i18n="privacy.heading">{t("privacy.heading")}</h1>
                <PolicyCards client:load />
            </div>
        </div>
    </div>
    <Sidebar slot="nav" />
    <FooterNav slot="footer" />
</Baselayout>

---
/**
 * プライバシーポリシーのページ。`PolicyCards` で収集する情報・利用目的・共有・保持期間・利用者の権利を示す。
 *
 * - 本文は辞書と定数だけに依存するため prerender する。ログインなしで開け、検索エンジンへの公開を許す。
 * - サイドバー・フッターナビを出さない単独ページで、ナビ項目一覧にも加えない
 *   （リンクは設定・ログイン・予約の認証情報の登録フォームに置く）。
 */
export const prerender = true
import PolicyCards from "@/components/privacy/PolicyCards"
import Baselayout from "@/components/layout/Baselayout/index.astro"
import StandaloneFooter from "@/components/layout/StandaloneFooter/index.astro"
import { createTranslator } from "@/lib/i18n/translate"
import ui from "@/styles/ui.module.css"

const { t } = createTranslator(Astro.locals.locale)
const robots = ["index", "follow", "noarchive", "noimageindex"]
---

<Baselayout cardPath={`/materials/ogp_main.png`} pageTitleKey="pageTitle.privacy" robots={robots}>
    <div class={ui.center}>
        <div class=`${ui.page} ${ui["width-lg"]} ${ui.center} `>
            <div class={ui["width-lg"]}>
                <h1 class={ui.subject} data-i18n="privacy.heading">{t("privacy.heading")}</h1>
                <PolicyCards client:load />
            </div>
            <StandaloneFooter />
        </div>
    </div>
</Baselayout>

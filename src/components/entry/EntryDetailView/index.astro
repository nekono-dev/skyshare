---
/**
 * Skyshare Entry 詳細ページの本文を表示し、SSR ページとサンプルページで共有する。
 *
 * - 下端の余白を常に置き、X アプリ内ブラウザなどで本文末尾が隠れるのを防ぐ。
 * - 見出しは本文に出さず、ページタイトルと OGP に使う。
 */
import EntryPostedAt from "@/components/entry/EntryDetailView/EntryPostedAt"
import PostBody from "@/components/timeline/PostBody"
import PostRichText from "@/components/timeline/PostRichText"
import type { SourceImage, SourceVideo } from "@/lib/entry/entry"
import type { PostFacet } from "@/lib/atproto/richTextSegments"
import type { PostLinkCard, PostQuote } from "@/lib/entry/postEmbedView"
import { createTranslator, type PlainMessageKey } from "@/lib/i18n/translate"
import ui from "@/styles/ui.module.css"
import styles from "./index.module.css"

export type EntryPostView = {
    webUrl: string
    author: { handle: string; displayName?: string; avatar?: string }
    /** ISO文字列。表示整形は PostBody が行う */
    createdAt: string
    text: string
    /** 本文の facets（メンション・ハッシュタグ・URLのリンク表示に使う） */
    facets?: PostFacet[]
    images: SourceImage[]
    /** 外部リンクの埋め込み */
    linkCard?: PostLinkCard
    /** 引用（画像・動画との併用を含む） */
    quote?: PostQuote
    /** 動画投稿の動画（再生可能） */
    video?: SourceVideo
    /** 利用不可の動画（再生不可の表示のみ） */
    unsupportedVideo?: SourceVideo
    engagement: { likeCount: number; repostCount: number; replyCount: number; quoteCount: number }
}

interface Props {
    statusCode: number
    /** 404 の本文に表示する理由の文言キー（省略時は「Entryが見つからない」） */
    notFoundReasonKey?: PlainMessageKey
    /** 見出し。ページ本文には表示せず、画像の alt にのみ使う（title表示用の値） */
    heading: string
    caption: string
    /** ISO文字列。表示整形は EntryPostedAt が行う（空なら日時なし） */
    createdAt: string
    sourcePostAvailable: boolean
    /** 元投稿（Bluesky）のWeb URL。空なら元投稿リンクを非表示 */
    sourceUrl?: string
    /** Entryのカード画像（View）のURL。無ければ非表示 */
    visualUrl?: string
    posts: EntryPostView[]
}

const {
    statusCode,
    notFoundReasonKey = "entry.detail.error404Body",
    heading,
    caption,
    createdAt,
    sourcePostAvailable,
    sourceUrl = "",
    visualUrl = "",
    posts,
} = Astro.props
const { t } = createTranslator(Astro.locals.locale)
const titleKey =
    statusCode === 404
        ? "entry.detail.error404Title"
        : statusCode === 503
          ? "entry.detail.error503Title"
          : "entry.detail.error500Title"
const bodyKey =
    statusCode === 404
        ? notFoundReasonKey
        : statusCode === 503
          ? "entry.detail.error503Body"
          : "entry.detail.error500Body"
---

{
    statusCode === 200 ? (
        <article class={styles.container}>
            <section class={`${ui["base-card"]} ${styles["header-card"]}`}>
                {caption ? (
                    <p class={styles["body-text"]}>
                        <PostRichText text={caption} />
                    </p>
                ) : null}
                {visualUrl ? (
                    <img class={styles.visual} src={visualUrl} alt={heading || caption} data-testid="entry-visual" />
                ) : null}
                <dl class={styles["meta-list"]}>
                    {sourceUrl && sourcePostAvailable ? (
                        <div>
                            <a
                                href={sourceUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-testid="entry-source-link"
                            >
                                <span data-i18n="entry.detail.viewSource">{t("entry.detail.viewSource")}</span>
                            </a>
                        </div>
                    ) : null}
                    <div>
                        <EntryPostedAt client:load createdAt={createdAt} />
                    </div>
                </dl>
                {!sourcePostAvailable ? (
                    <p class={styles["empty-message"]} data-i18n="entry.detail.sourceDeleted">
                        {t("entry.detail.sourceDeleted")}
                    </p>
                ) : null}
            </section>

            {posts.length > 0 ? (
                <ol class={styles["post-list"]}>
                    {posts.map(post => (
                        <li class={styles["post-item"]}>
                            <div class={`${ui["base-card"]} ${styles["post-card"]}`}>
                                <PostBody
                                    client:load
                                    author={post.author}
                                    createdAt={post.createdAt}
                                    text={post.text}
                                    facets={post.facets}
                                    images={post.images}
                                    video={post.video}
                                    unsupportedVideo={post.unsupportedVideo}
                                    unsupportedVideoLinkUrl={post.webUrl}
                                    postUrl={post.webUrl}
                                    linkCard={post.linkCard}
                                    quote={post.quote}
                                    engagement={post.engagement}
                                />
                            </div>
                        </li>
                    ))}
                </ol>
            ) : null}
        </article>
    ) : (
        <section class={styles["error-pane"]}>
            <h1 data-i18n={titleKey}>
                {statusCode === 404
                    ? t("entry.detail.error404Title")
                    : statusCode === 503
                      ? t("entry.detail.error503Title")
                      : t("entry.detail.error500Title")}
            </h1>
            <p data-i18n={bodyKey}>
                {statusCode === 404
                    ? t(notFoundReasonKey)
                    : statusCode === 503
                      ? t("entry.detail.error503Body")
                      : t("entry.detail.error500Body")}
            </p>
        </section>
    )
}

<footer class={styles["page-footer"]} aria-hidden="true"></footer>

---
/**
 * Skyshare Entry詳細ページの本文表示（`<article>`/エラーペイン部分）。
 *
 * 責務と処理概要:
 * - `entries/[slug].astro`（PDSから実レコードをSSR取得する本来のEntry詳細ページ）と
 *   `entries/sample.astro`/`entries/sample-orphaned.astro`（ログイン不要のゲストモード
 *   向け固定サンプルページ）から共通で使う。データの取得元（実レコード or 固定ダミー
 *   データ）が異なるだけで
 *   見た目・マークアップ構造は完全に一致させたいため、ここに一本化している。
 * - `Baselayout`でのラップ（`pageTitle`/`cardPath`等のメタ情報）は呼び出し側の責務。
 */
import PostEngagementStats from "@/components/post/PostEngagementStats"
import type { SourceImage } from "@/lib/entry/entry"
import styles from "./index.module.css"

interface Props {
    statusCode: number
    notFoundReason?: string
    manifestHeading: string
    manifestCaption: string
    sourcePostAvailable: boolean
    sourceWebUrl: string
    createdAtText: string
    likeCount: number
    repostCount: number
    replyCount: number
    quoteCount: number
    sourceImages: SourceImage[]
}

const {
    statusCode,
    notFoundReason = "",
    manifestHeading,
    manifestCaption,
    sourcePostAvailable,
    sourceWebUrl,
    createdAtText,
    likeCount,
    repostCount,
    replyCount,
    quoteCount,
    sourceImages,
} = Astro.props
---

{
    statusCode === 200 ? (
        <article class={styles.container}>
            <header>
                <h1 class={styles.heading}>{manifestHeading}</h1>
            </header>

            {!sourcePostAvailable ? (
                <p class={styles["empty-message"]}>
                    元の投稿は削除されているため、保存された内容のみを表示しています。
                </p>
            ) : null}

            {manifestCaption ? <p class={styles["body-text"]}>{manifestCaption}</p> : null}

            <dl class={styles["meta-list"]}>
                <div>
                    {sourcePostAvailable ? (
                        <a href={sourceWebUrl} rel="noopener noreferrer" target="_blank">
                            Blueskyの投稿を見る
                        </a>
                    ) : (
                        "Blueskyの投稿は見つかりませんでした"
                    )}
                </div>
                <div>投稿日時: {createdAtText ? createdAtText : "no data"}</div>
            </dl>

            {sourcePostAvailable ? (
                <PostEngagementStats
                    client:visible
                    likeCount={likeCount}
                    repostCount={repostCount}
                    replyCount={replyCount}
                    quoteCount={quoteCount}
                />
            ) : null}

            {sourcePostAvailable ? (
                sourceImages.length > 0 ? (
                    <section class={styles["image-grid"]} aria-label="source images">
                        {sourceImages.map(image => (
                            <figure class={styles["image-card"]}>
                                <img src={image.url} alt={image.alt} loading="lazy" decoding="async" />
                                {image.alt ? <figcaption>{image.alt}</figcaption> : null}
                            </figure>
                        ))}
                    </section>
                ) : (
                    <p class={styles["empty-message"]}>画像はありません。</p>
                )
            ) : null}
        </article>
    ) : (
        <section class={styles["error-pane"]}>
            <h1>
                {statusCode === 404
                    ? "Entry Not Found"
                    : statusCode === 503
                      ? "Service Temporarily Unavailable"
                      : "Internal Server Error"}
            </h1>
            <p>
                {statusCode === 404
                    ? notFoundReason
                    : statusCode === 503
                      ? "データ取得が混み合っています。しばらくして再度お試しください。"
                      : "ページの生成中にエラーが発生しました。"}
            </p>
        </section>
    )
}

---
/**
 * Sidebar と FooterNav が共有するナビアイコン。
 *
 * - 色違いの SVG を重ね、呼び出し側 CSS が `.item:hover`・`.item[aria-current="page"]` で
 *   `data-nav-icon="active"` 側の opacity を切り替える（インライン SVG の複製を避けるため）。
 * - accounts のアバターの URL は prerender 時に分からないため、プレースホルダーだけを出し、
 *   `nav/syncAccountAvatar.ts` がクライアントで `data-account-avatar-img` の src を補う。
 * - サイズは呼び出し側 CSS が `[data-nav-icon-root]` で指定する（tokens.css の `--size-icon-sm`・`--size-icon-md`）。
 */
import styles from "./index.module.css"
import docBluesky from "@/images/doc.svg"
import docMuted from "@/images/doc-muted.svg"
import blueskyBluesky from "@/images/bluesky.svg"
import blueskyMuted from "@/images/bluesky-muted.svg"
import settingsBluesky from "@/images/settings.svg"
import settingsMuted from "@/images/settings-muted.svg"
import someone from "@/images/someone.svg"
import type { NavItem } from "@/components/layout/nav/navItems"

interface Props {
    navKey: NavItem["key"]
}

const { navKey } = Astro.props

const iconSrcByKey = {
    entries: { muted: docMuted.src, active: docBluesky.src },
    post: { muted: blueskyMuted.src, active: blueskyBluesky.src },
    settings: { muted: settingsMuted.src, active: settingsBluesky.src },
} as const
---

{
    navKey === "accounts" ? (
        <span class={styles["avatar-wrap"]} data-nav-icon-root>
            <img class={styles["avatar-placeholder"]} src={someone.src} alt="" aria-hidden="true" />
            <img class={styles["avatar-img"]} data-account-avatar-img alt="" hidden />
        </span>
    ) : (
        <span class={styles["icon-swap"]} data-nav-icon-root>
            <img src={iconSrcByKey[navKey].muted} data-nav-icon="muted" alt="" aria-hidden="true" />
            <img src={iconSrcByKey[navKey].active} data-nav-icon="active" alt="" aria-hidden="true" />
        </span>
    )
}

---
/**
 * モバイル専用(640px未満)の画面下固定ナビゲーション(Post一覧・Entry一覧・アカウント切り替え)。
 *
 * 責務と処理概要:
 * - 640px未満でのみ表示する(640px以上はSidebarが担当、このコンポーネントは
 *   display:noneで非表示のままDOMには常に存在する)。
 * - `position: fixed` で画面最下部に固定するため、.shell (CSS Grid) には
 *   参加せず、Baselayout.astro内で .shell の兄弟要素として配置される。
 * - `Astro.url.pathname` から現在地を判定し、該当リンクへ `aria-current` を付与する。
 * - `transition:persist` によりView Transitions中もDOMを再生成せず保持する。
 *   保持されたDOMのaria-currentは src/components/nav/syncActiveState.ts が同期し直す。
 */
import styles from "./index.module.css"
import { footerNavItems, normalizePathname, isActiveHref } from "@/components/layout/nav/navItems"
import NavIcon from "@/components/layout/nav/NavIcon.astro"

const current = normalizePathname(Astro.url.pathname)
// URLに `?guest` が付いている場合、ナビゲーション遷移後もゲスト表示を維持できるよう
// 各リンクのhrefにも引き継ぐ。ただしこのコンポーネントは prerender されるページに
// 埋め込まれておりビルド時には実際のリクエストURLが分からないため、ここでは付与できない。
// 実際の付与は `@/components/layout/nav/syncGuestModeQuery`(クライアント実行)が担う。
---

<nav class={styles.nav} aria-label="メインナビゲーション" data-nav="footer" transition:persist="footer-nav">
    {
        footerNavItems.map(item => (
            <a
                href={item.href}
                class={styles.item}
                data-nav-key={item.key}
                aria-current={isActiveHref(item.href, current) ? "page" : undefined}
                aria-label={item.ariaLabel}
            >
                <span class={styles["item-icon"]} aria-hidden="true">
                    <NavIcon navKey={item.key} />
                </span>
                <span class={styles["item-label"]}>{item.label}</span>
            </a>
        ))
    }
</nav>

<script>
    import "@/components/layout/nav/syncActiveState"
    import "@/components/layout/nav/syncAccountAvatar"
    import "@/components/layout/nav/syncGuestModeQuery"
</script>

---
/**
 * 画面幅640px以上で常設するサイドバーのナビゲーション（640px未満は FooterNav が担う）。
 *
 * - 640〜847px はアイコンの丸ボタンのみ、848px以上はラベル付き。640px未満では display:none にして DOM には残す。
 * - 幅と位置は src/styles/ui.module.css の .shell (CSS Grid) の1列目が決めるため、width・left を指定しない。
 * - `transition:persist` で DOM を保持するため、`aria-current` は `nav/syncActiveState.ts` が同期し直す。
 */
import styles from "./index.module.css"
import ui from "@/styles/ui.module.css"
import { sidebarNavItems, normalizePathname, isActiveHref } from "@/components/layout/nav/navItems"
import NavIcon from "@/components/layout/NavIcon/index.astro"
import { createTranslator } from "@/lib/i18n/translate"

const current = normalizePathname(Astro.url.pathname)
// 文言は描画時の表示言語で出し、言語変更・ページ遷移後は data-i18n 系属性を目印にクライアントが書き換える。
const { t } = createTranslator(Astro.locals.locale)
// URLに `?guest` が付いている場合、ナビゲーション遷移後もゲスト表示を維持できるよう
// 各リンクのhrefにも引き継ぐ。ただしこのコンポーネントは prerender されるページに
// 埋め込まれておりビルド時には実際のリクエストURLが分からないため、ここでは付与できない。
// 実際の付与は `@/components/layout/nav/syncGuestModeQuery`(クライアント実行)が担う。
---

<nav
    class={styles.nav}
    aria-label={t("nav.main")}
    data-i18n-aria-label="nav.main"
    data-nav="sidebar"
    transition:persist="sidebar-nav"
>
    {
        sidebarNavItems.map(item => (
            <a
                href={item.href}
                class={`${styles.item} ${ui["text-muted"]}`}
                data-nav-key={item.key}
                aria-current={isActiveHref(item.href, current) ? "page" : undefined}
                aria-label={t(item.ariaLabelKey)}
                data-i18n-aria-label={item.ariaLabelKey}
            >
                <span
                    class={`${styles["item-icon"]} ${ui["base-button"]} ${ui["nontext-button"]} ${item.key === "accounts" ? ui["lg-button"] : ui["md-button"]}`}
                    aria-hidden="true"
                >
                    <NavIcon navKey={item.key} />
                </span>
                <span class={styles["item-label"]} data-i18n={item.labelKey}>
                    {t(item.labelKey)}
                </span>
            </a>
        ))
    }
    {/* サイドバー表示時、PostLauncher がここへ「新規投稿」ボタンを Portal で描画する */}
    <div id="sidebar-action"></div>
</nav>

<script>
    import "@/components/layout/nav/syncActiveState"
    import "@/components/layout/nav/syncAccountAvatar"
    import "@/components/layout/nav/syncGuestModeQuery"
</script>

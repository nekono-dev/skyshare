---
/**
 * OAuth のログインの戻りのステータスの表示（ログインとアカウントのページ）。
 *
 * 責務と処理概要:
 * - 戻りの部品（`LoginAuthorizationReturn`）が動き出すまでの間、「ログイン中…」を表示する。
 *   表示は `<html data-oauth-returning="pending">` の間だけ CSS で出す（印は Baselayout の先頭のスクリプトが付ける）。
 * - 戻りの部品を置き、動き出した後の進行と結果の表示はそちらに任せる。
 *
 * 実装上の制約:
 * - 動き出す前の文言は React の外に置き、`data-i18n` で表示言語に合わせる。
 */
import LoginAuthorizationReturn from "./index"
import styles from "./index.module.css"
import { createTranslator } from "@/lib/i18n/translate"

const { t } = createTranslator(Astro.locals.locale)
---

<div class={styles.status}>
    <div class={styles.pending} aria-live="polite" data-i18n="account.login.progress">
        {t("account.login.progress")}
    </div>
    <LoginAuthorizationReturn client:load />
</div>

{
  // routes の pattern（SITE_HOST）は hack/render-deploy-config.mjs が環境変数で置き換える。
  // `--develop` では Worker・D1・R2 の名前の末尾に -develop を付ける
  "name": "skyshare",
  // Set this to today's date
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client/",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "SITE_HOST",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  "vars": {
    "PUBLIC_LEGACY_BACKEND_ENDPOINT": "https://backend.example.com/api/v1",
    "PUBLIC_DEFAULT_ATP_SERVICE": "https://api.bsky.app",
    "PUBLIC_NODE_ENV": "develop",
    "PUBLIC_OGP_EXTRACTOR_API": "https://ogpextractor.example.com",
    "PUBLIC_PLC_DIRECTORY_BASE_URL": "https://plc.directory",
  },
  "workers_dev": false,
  "preview_urls": false,
  // プレビューは develop の Worker（--develop）だけで作る。D1・R2 は hack/render-deploy-config.mjs が加える
  "previews": {
    "vars": {
      "PUBLIC_LEGACY_BACKEND_ENDPOINT": "https://backend.example.com/api/v1",
      "PUBLIC_DEFAULT_ATP_SERVICE": "https://api.bsky.app",
      "PUBLIC_NODE_ENV": "develop",
      "PUBLIC_OGP_EXTRACTOR_API": "https://ogpextractor.example.com",
      "PUBLIC_PLC_DIRECTORY_BASE_URL": "https://plc.directory",
    },
  },
}

{
  // 大文字の値（WORKER_NAME など）は hack/render-deploy-config.mjs が環境変数で置き換える
  "name": "WORKER_NAME",
  // 画面と API は Astro のアダプタに任せ、定期実行（scheduled）を加えた自前のエントリを使う
  "main": "src/worker.ts",
  // Set this to today's date
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client/",
    "binding": "ASSETS",
  },
  // 予約投稿を実行時刻に実行する定期実行（無料枠で使える最短の1分間隔）
  "triggers": {
    "crons": ["* * * * *"],
  },
  // 予約の保管（D1）と添付画像の一時保管（R2）
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "SCHEDULE_D1_NAME",
      "database_id": "SCHEDULE_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SCHEDULE_IMAGES",
      "bucket_name": "SCHEDULE_R2_BUCKET",
    },
  ],
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "SITE_HOST",
      "zone_name": "ZONE_NAME",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": true,
    },
  ],
  "vars": {
    "PUBLIC_LEGACY_BACKEND_ENDPOINT": "https://backend.example.com/api/v1",
    "PUBLIC_DEFAULT_ATP_SERVICE": "https://api.bsky.app",
    "PUBLIC_NODE_ENV": "develop",
    "PUBLIC_OGP_EXTRACTOR_API": "https://ogpextractor.example.com",
    "PUBLIC_PLC_DIRECTORY_BASE_URL": "https://plc.directory",
  },
  "workers_dev": false,
  "preview_urls": false,
  "previews": {
    // プレビューは本番のデータと分けた専用の D1・R2 を使う
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "PREVIEW_D1_NAME",
        "database_id": "PREVIEW_D1_DATABASE_ID",
      },
    ],
    "r2_buckets": [
      {
        "binding": "SCHEDULE_IMAGES",
        "bucket_name": "PREVIEW_R2_BUCKET",
      },
    ],
    "vars": {
      "PUBLIC_LEGACY_BACKEND_ENDPOINT": "https://backend.example.com/api/v1",
      "PUBLIC_DEFAULT_ATP_SERVICE": "https://api.bsky.app",
      "PUBLIC_NODE_ENV": "develop",
      "PUBLIC_OGP_EXTRACTOR_API": "https://ogpextractor.example.com",
      "PUBLIC_PLC_DIRECTORY_BASE_URL": "https://plc.directory",
    },
  },
}

{
  "name": "skyshare",
  // Set this to today's date
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client/",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "skyshare.nekono.dev",
      "zone_name": "nekono.dev",
      "custom_domain": true,
      "enabled": true,
      // 同じドメインでブランチ別プレビュー（<名前>.skyshare.nekono.dev）も配信する
      "previews_enabled": true,
    },
  ],
  "vars": {
    "PUBLIC_LEGACY_BACKEND_ENDPOINT": "https://backend.example.com/api/v1",
    "PUBLIC_DEFAULT_ATP_SERVICE": "https://api.bsky.app",
    "PUBLIC_NODE_ENV": "develop",
    "PUBLIC_OGP_EXTRACTOR_API": "https://ogpextractor.example.com",
    "PUBLIC_PLC_DIRECTORY_BASE_URL": "https://plc.directory",
  },
  // workers_dev / preview_urls は、独自ドメインの有効状況に合わせて CI の生成時に
  // branch-release-workflow の wrangler-config が設定する（hack/render-deploy-config.mjs）。
  // 独自ドメインを配信するため両方 false（旧方式の Version URL / --preview-alias は使わない）。
  // ブランチ別プレビューは wrangler preview を使う
  "workers_dev": false,
  "preview_urls": false,
  // wrangler preview の設定。トップレベルの vars は引き継がれないため、同じ値を明示する
  "previews": {
    "vars": {
      "PUBLIC_LEGACY_BACKEND_ENDPOINT": "https://backend.example.com/api/v1",
      "PUBLIC_DEFAULT_ATP_SERVICE": "https://api.bsky.app",
      "PUBLIC_NODE_ENV": "develop",
      "PUBLIC_OGP_EXTRACTOR_API": "https://ogpextractor.example.com",
      "PUBLIC_PLC_DIRECTORY_BASE_URL": "https://plc.directory",
    },
  },
}

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables（雛形 `*.template` のみ管理対象）
.env
.dev.vars
.env.staging
.env.production
# 認証情報を含み得るenvファイル（雛形 `*.template` のみ管理対象）
.env.e2e

# macOS-specific files
.DS_Store

# Gen clients
src/client/**/
/openapi/generated.json

# Astro build
.astro
/dist
.wrangler
/wrangler.jsonc
/.memo

# Playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache
/playwright/.auth

_legacy/**/.env.test
_legacy/**/.env.test.*
!_legacy/**/.env.test.template

# 配備に使う設定値（deploy.env.template のコピー。運用者の値と認証情報を含む。npm run deploy:env で登録する）
/deploy.env

# 環境側に導入するスキル（AGENTS.md「仕様駆動開発」参照）。入れ子の git リポジトリのため追跡しない
.claude/skills/spec-driven-development/

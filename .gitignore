# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables（雛形 `*.template` のみ管理対象）
.env
.dev.vars
.env.staging
.env.production

# macOS-specific files
.DS_Store

# Gen clients
src/client/**/

# 変数 SURVEY_CONFIG から生成する配信用のアンケート設定（npm run survey:render）
/public/surveys/

# Astro build
.astro
/dist
.wrangler
/wrangler.jsonc
# 非秘密の設定（config/<名前>.json）は運用者ごとの値を含むため追跡しない。例（*.example.json）だけを追跡する。wrangler.jsonc はここから生成する
/config/*.json
!/config/*.example.json
/.memo

# Playwright
/playwright-report
/blob-report
/tests/e2e/.auth/

_legacy/**/.env.test
_legacy/**/.env.test.*
!_legacy/**/.env.test.template


# brw create が作る作業ブランチの worktree
.claude/worktrees/
# 個人の承認（MCP サーバーの有効化など）。共有の設定には書かない
.claude/settings.local.json

# cc-sdd の導入物（MIT のため本リポジトリには含めない）。SessionStart で固定版を導入し直す（scripts/agent/install-cc-sdd.sh）
.claude/skills/kiro-*/
.kiro/settings/
# テストの実行で生成される計測の出力と変異テストの一時領域
/.cache/

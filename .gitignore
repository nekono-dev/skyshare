# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables（雛形 `*.template` のみ管理対象）
.env
.dev.vars
.env.staging
.env.production
# 認証情報を含み得るenvファイル（雛形 `*.template` のみ管理対象）
.env.e2e

# macOS-specific files
.DS_Store

# Gen clients
src/client/**/
/openapi/generated.json

# 変数 SURVEY_CONFIG から生成する配信用のアンケート設定（npm run survey:render）
/public/surveys/

# Astro build
.astro
/dist
.wrangler
/wrangler.jsonc
/.memo

# Playwright
/test-results
/playwright-report
/blob-report
/playwright/.cache
/playwright/.auth

_legacy/**/.env.test
_legacy/**/.env.test.*
!_legacy/**/.env.test.template

# 配備に使う設定値（deploy.env.template のコピー。運用者の値と認証情報を含む。npm run deploy:env で登録する）
/deploy.env

# brw create が作る作業ブランチの worktree
.claude/worktrees/

# cc-sdd の skill（セッション開始時に .claude/hooks/install-cc-sdd.sh が導入する）。CLAUDE.md・.kiro は追跡する
/.claude/skills/kiro-*/
/.claude/skills/.cc-sdd-version

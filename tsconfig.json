{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "tests/**/*",
    "scripts/**/*",
    "./worker-configuration.d.ts",
    "./config/orval.config.ts",
    "./config/test/vitest.unit.config.ts",
    "./config/test/vitest.component.config.ts",
    "./config/test/vitest.route.config.ts",
    "./config/test/vitest.astro.config.ts",
    "./config/test/playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "tests/fixtures/import-rules"],
  "compilerOptions": {
    "verbatimModuleSyntax": false,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "rootDir": "./",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}

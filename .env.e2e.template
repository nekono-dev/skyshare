# テスト・解析用の環境変数の雛形。
# リポジトリ直下に .env.e2e としてコピーし、値を書き換えて使う（.env.e2e は .gitignore 対象）。
#   cp .env.e2e.template .env.e2e
# CI のライブテストには、この中身をそのまま Secret E2E_ENV に登録する。
#   gh secret set E2E_ENV -R <owner>/<repo> < .env.e2e
# 任意の値は、使わない場合は行ごと消す（空の値は登録しない）。

# --- 実アカウントのE2E（ライブテスト。tests/e2e/live/） ---
# 必ず検証専用のアカウントとアプリパスワードを使う
SKYSHARE_E2E_IDENTIFIER=test.bsky.social
SKYSHARE_E2E_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# PDS の URL（任意。既定 https://bsky.social）
#SKYSHARE_E2E_SERVICE=https://bsky.social
# 第三者の返信のテスト用アカウント（任意。未設定ならスキップ）
#SKYSHARE_E2E_PEER_IDENTIFIER=peer.bsky.social
#SKYSHARE_E2E_PEER_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# 300MB級の動画のライブテストを実行する（任意。時間とBlueskyの動画アップロード残量を消費する）
#SKYSHARE_E2E_LARGE_VIDEO=1

# --- 本番の解析（Cloudflare API。CPU時間・エラーの取得） ---
# 読み取り専用の Analytics トークン
#CLOUDFLARE_ANALYTICS_TOKEN=
# Workers のデプロイ権限を持つトークン（CI は Secret CLOUDFLARE_API_TOKEN を使う）
#CLOUDFLARE_API_TOKEN=

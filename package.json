{
  "name": "skyshare",
  "type": "module",
  "version": "2.0.0-preview.r09",
  "scripts": {
    "prepare": "node scripts/git/setup-git-hooks.mjs",
    "apigen:doc": "tsx ./scripts/build/build-openapi-document.ts",
    "apigen:client": "tsx ./node_modules/.bin/orval --config config/orval.config.ts",
    "apigen": "npm run apigen:doc && npm run apigen:client",
    "codegen": "npm run apigen",
    "setup:local": "node scripts/secrets/prepare-local-env.mjs",
    "survey": "tsx ./hack/survey-cli/cli.ts",
    "survey:render": "tsx ./scripts/survey/render-survey-config.ts",
    "build:prepare": "npm run codegen && npm run survey:render && npm run format",
    "build:legacy": "cd _legacy/frontend && npm ci && npm run build",
    "build:v2": "npm run survey:render && PUBLIC_VERSION=$npm_package_version astro build",
    "build": "npm run build:prepare && npm run build:v2 && npm run build:legacy && cp -r _legacy/frontend/dist/legacy dist/client/legacy",
    "dev": "npm run build:prepare && npm run setup:local && PUBLIC_VERSION=$npm_package_version astro dev",
    "dev:build": "npm run setup:local && npm run build && wrangler dev --ip 0.0.0.0",
    "prev": "npm run build && wrangler preview",
    "deploy": "npm run build && wrangler deploy",
    "format": "prettier --write .",
    "generate-types": "wrangler types",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run -c config/test/vitest.unit.config.ts",
    "test:render": "vitest run -c config/test/vitest.astro.config.ts",
    "test:lexicon": "./scripts/build/lint-lexicon.sh",
    "test:imports": "tsx ./scripts/architecture/check-imports.ts",
    "test:component": "vitest run -c config/test/vitest.component.config.ts",
    "test:route": "vitest run -c config/test/vitest.route.config.ts",
    "test:mutation": "stryker run config/test/stryker.config.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e/run-e2e.mjs",
    "test:live": "vitest run -c config/test/vitest.live.config.ts",
    "sync:github": "node scripts/secrets/sync-github-variables.mjs",
    "test:all": "npm run codegen && npm run test:type && npm run test:lexicon && npm run test:imports && npm run test:unit && npm run test:component && npm run test:route && npm run test:render && npm run test:e2e",
    "test": "npm run test:all"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.4",
    "@astrojs/partytown": "^2.1.8",
    "@astrojs/react": "6.0.1",
    "@atproto/api": "^0.23.0",
    "@atproto/common-web": "^0.5.9",
    "@atproto/lex-cbor": "^0.1.6",
    "@atproto/xrpc": "^0.7.7",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "astro": "7.3.2",
    "hls.js": "^1.7.3",
    "multiformats": "^13.4.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-easy-crop": "^5.5.6",
    "tlds": "^1.261.0",
    "twitter-text": "*",
    "zod": "*"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.9.8",
    "@atproto/lexicon": "^0.7.16",
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.2.0",
    "@types/twitter-text": "*",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitest/coverage-istanbul": "^4.1.11",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "orval": "^8.32.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-sh": "^0.18.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0",
    "zod-openapi": "*"
  },
  "author": "nekono.dev"
}
